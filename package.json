{
  "name": "ios-webdriverio",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@wdio/allure-reporter": "^9.16.2",
    "@wdio/appium-service": "^9.12.7",
    "@wdio/cli": "^9.14.0",
    "@wdio/local-runner": "^9.3.1",
    "@wdio/mocha-framework": "^9.5.0",
    "@wdio/spec-reporter": "^9.16.2",
    "@wdio/visual-service": "^6.3.2",
    "appium": "^2.17.1",
    "appium-xcuitest-driver": "^8.4.3",
    "chai": "^5.2.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.1",
    "esm": "^3.2.25",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "wdio-docker-service": "^3.2.1",
    "wdio-timeline-reporter": "^5.1.4"
  },
  "scripts": {
    "appium": "appium",
    "format": "prettier --write .",
    "lint": "eslint test/**/*.js",
    "kill-ports": "lsof -i :4723 -t -s TCP:LISTEN | xargs kill -9 && lsof -i :8100 -t -s TCP:LISTEN | xargs kill -9 && lsof -i :8101 -t -s TCP:LISTEN | xargs kill -9 && lsof -i :8102 -t -s TCP:LISTEN | xargs kill -9 && lsof -i :8103 -t -s TCP:LISTEN | xargs kill -9",
    "dev": "wdio run wdio.conf.js --workflow='Continuous Delivery' --env=stage --suite=debug",
    "test": "wdio run wdio.conf.js",
    "test:install:cd:stage": "wdio run wdio.conf.js --workflow='Continuous Delivery' --suite='deploymentInstallation'",
    "test:install:cd:prod": "wdio run wdio.conf.js --workflow='Continuous Delivery' --env=prod --suite=deploymentInstallation",
    "test:install:rc:stage": "wdio run wdio.conf.js --workflow='Release Candidates' --suite=deploymentInstallation",
    "test:install:rc:prod": "wdio run wdio.conf.js --workflow='Release Candidates' --env=prod --suite=deploymentInstallation",
    "test:amplitude:stage": "npx mocha 'test/specs/analytics/{p1,p2,p3}/**/*.js'",
    "list:cd:stage": "node appstoreconnect/cli.js listAllCdStageBuildRuns",
    "list:cd:prod": "node appstoreconnect/cli.js listAllCdProdBuildRuns",
    "list:rc:stage": "node appstoreconnect/cli.js listAllRcStageBuildRuns",
    "list:rc:prod": "node appstoreconnect/cli.js listAllRcProdBuildRuns",
    "fetch:cd:stage:artifacts": "node appstoreconnect/cli.js fetchLatestCdStageArtifacts",
    "fetch:cd:prod:artifacts": "node appstoreconnect/cli.js fetchLatestCdProdArtifacts",
    "fetch:rc:stage:artifacts": "node appstoreconnect/cli.js fetchLatestRcStageArtifacts",
    "fetch:rc:prod:artifacts": "node appstoreconnect/cli.js fetchLatestRcProdArtifacts",
    "clear:cd:stage:artifacts": "node appstoreconnect/cli.js clearOldCdStageArtifacts",
    "clear:cd:prod:artifacts": "node appstoreconnect/cli.js clearOldCdProdArtifacts",
    "clear:rc:stage:artifacts": "node appstoreconnect/cli.js clearOldRcStageArtifacts",
    "clear:rc:prod:artifacts": "node appstoreconnect/cli.js clearOldRcProdArtifacts",
    "clear:all:artifacts": "node appstoreconnect/cli.js clearAllArtifacts"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.8.4",
    "dotenv": "^16.5.0",
    "firebase-admin": "^13.4.0",
    "jsonwebtoken": "^9.0.2",
    "mailosaur": "^8.8.1",
    "unzipper": "^0.12.3"
  }
}
